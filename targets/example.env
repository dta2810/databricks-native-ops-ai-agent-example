# Copy to targets/<target>.env (gitignored) and fill in. Every script reads it when BEV_TARGET=<target>.
# Ids the scripts create (Genie spaces, MLflow experiment) go to targets/<target>.resolved.env.

# Environment suffix (REQUIRED, 1-12 chars a-z0-9). Account groups, the app name and Genie space titles are
# account- or workspace-wide: pick a suffix nobody else on the account uses (for example your initials + a number)
BEV_ENV=<unique-suffix>

# Databricks workspace (Unity Catalog, serverless, Databricks Apps, Lakebase Autoscaling)
DATABRICKS_CONFIG_PROFILE=<workspace-cli-profile>
BEV_ACCOUNT_PROFILE=<account-cli-profile>        # account admin, for setup/identities.py
BEV_WORKSPACE_ID=<workspace-id>
BEV_CATALOG=<existing-catalog>                   # you need CREATE SCHEMA on it
BEV_WAREHOUSE_ID=<serverless-sql-warehouse-id>   # the app queries it as the user (users need CAN_USE)

# Group members (comma-separated emails). Planners read + propose; approvers also decide; viewers read traces.
BEV_PLANNERS=<email>,<email>
BEV_APPROVERS=<email>
BEV_VIEWERS=<email>
# Optional: principals you accept as trace readers beyond the viewer group (e.g. a workspace admin with catalog ALL PRIVILEGES), comma-separated
# BEV_VERIFY_ACCEPTED_TRACE_READERS=

# Resource tags (JSON). Account tag policies may restrict keys or values.
BEV_TAGS={"bev_project": "bev_ops_<env>", "owner": "<owner>"}

# Optional overrides (defaults shown, <env> = BEV_ENV)
# BEV_SCHEMA=bev_ops_<env>
# BEV_PROMPT_SCHEMA=bev_ops_<env>_prompts          # prompts only; the app SP gets MANAGE here, never on BEV_SCHEMA
# BEV_APP_NAME=bev-ops-<env>                     # immutable once created, max 30 chars
# BEV_LAKEBASE_PROJECT=bev-ops-<env>
# BEV_PLANNER_GROUP=bev_ops_planner_<env>   BEV_APPROVER_GROUP=bev_ops_approver_<env>   BEV_VIEWER_GROUP=bev_ops_viewer_<env>
# BEV_LLM_FAST_MODEL=databricks-claude-haiku-4-5   BEV_LLM_REASONING_MODEL=databricks-claude-sonnet-5
# BEV_TRACE_MASK_USER=true                       # hash user emails in traces (salt: BEV_TRACE_SALT, else the workspace id)
# BEV_MAX_PROPOSALS_PER_TURN=3   BEV_MAX_PENDING_PER_USER=10   BEV_CHAT_RATE_PER_MIN=10

# Deploy-only knobs (scripts/deploy.py)
# BEV_DEPLOY_ALLOW_SELF_APPROVAL=false           # true + BEV_DEPLOY_SINGLE_PRESENTER_MODE=1 = one presenter approves own requests
# BEV_DEPLOY_SINGLE_PRESENTER_MODE=0
